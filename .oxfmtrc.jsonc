{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "sanity.types.ts",
    "routeTree.gen.ts",
    "CHANGELOG.md",
    ".changeset/*.md",
    ".agents",
    "packages/tailwind/tokens/primitives.css",
    "packages/tailwind/tokens/semantic.css",
    "packages/tailwind/tokens/typography.css",
    "packages/tailwind/tokens/motion.css",
    "packages/tailwind/tokens/theme.css",
    "packages/tailwind/tokens/themes/*.css",
  ],
  "singleQuote": true,
  "sortPackageJson": {
    "sortScripts": true,
  },
  "sortImports": {},
  "sortTailwindcss": {
    "functions": ["cx", "cva"],
  },
}
