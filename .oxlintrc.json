{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "unicorn",
    "typescript",
    "oxc",
    "import",
    "vitest",
    "react",
    "react-perf",
    "eslint",
    "jsx-a11y",
    "promise",
    "node"
  ],
  "jsPlugins": ["eslint-plugin-better-tailwindcss"],
  "ignorePatterns": ["sanity.types.ts", "routeTree.gen.ts", ".agents"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "better-tailwindcss/enforce-canonical-classes": "error",
    "better-tailwindcss/no-restricted-classes": [
      "error",
      {
        "selectors": [
          { "kind": "attribute", "name": "^class(?:Name)?$" },
          { "kind": "callee", "name": "^cx$", "match": [{ "type": "strings" }] },
          {
            "kind": "callee",
            "name": "^cva$",
            "match": [{ "type": "strings" }, { "type": "objectValues" }]
          }
        ],
        "restrict": [
          {
            "pattern": "\\[[^\\]]*=[\"']",
            "message": "Leave attribute values in arbitrary variants unquoted, e.g. [data-slot=media]. tsdown escapes the quotes in the bundle, and consumers' Tailwind then generates selectors that never match."
          }
        ]
      }
    ]
  },
  "settings": {
    "better-tailwindcss": {
      "entryPoint": "apps/docs/src/styles/app.css"
    }
  },
  "overrides": [
    {
      "files": ["**/*.stories.tsx"],
      "rules": {
        "jsx-a11y/anchor-is-valid": "off"
      }
    }
  ]
}
