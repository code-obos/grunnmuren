{
  "name": "@obosbbl/grunnmuren-tailwind",
  "version": "2.8.0",
  "description": "Grunnmuren Tailwind preset",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/code-obos/grunnmuren"
  },
  "bin": {
    "grunnmuren-theme": "./theme/cli.mjs"
  },
  "files": [
    "tailwind-base.css",
    "tailwind-typography.css",
    "font.css",
    "theme",
    "tokens",
    "!tokens/source",
    "!tokens/themes"
  ],
  "type": "commonjs",
  "exports": {
    ".": "./tailwind-base.css",
    "./colors.json": "./tokens/colors.json",
    "./theme": {
      "types": "./theme/index.d.mts",
      "default": "./theme/index.mjs"
    }
  },
  "scripts": {
    "font-fallback": "bun --cwd=./fonts ./generate-font-fallback.ts"
  },
  "dependencies": {
    "tw-animate-css": "^1.2.5"
  },
  "devDependencies": {
    "style-dictionary": "5.7.0",
    "tailwindcss": "catalog:"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  }
}
