{
  "name": "grunnmuren",
  "private": true,
  "description": "Monorepo for Grunnmuren, OBOS' design system",
  "repository": {
    "url": "https://github.com/code-obos/grunnmuren"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/**' build",
    "build:docs": "pnpm --filter @obosbbl/grunnmuren-docs build",
    "build:storybook": "storybook build -o ./apps/docs/public/storybook",
    "ci:publish": "pnpm build && changeset publish",
    "ci:version": "changeset version",
    "dev": "storybook dev -p 6006 --ci --initial-path=/story/home--page",
    "dev:docs": "pnpm --filter @obosbbl/grunnmuren-docs dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "sanity:schema:deploy": "pnpm --filter @obosbbl/grunnmuren-docs sanity:schema:deploy",
    "serve-storybook": "http-server ./apps/docs/public/storybook -p 6006 --silent",
    "test": "vitest run",
    "test:screenshots:update": "vitest run --project='storybook:*' --update",
    "test:watch": "vitest",
    "tokens:build": "vitest run --project tokens -u -t \"generated token css\""
  },
  "dependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@obosbbl/grunnmuren-tailwind": "workspace:*",
    "@react-aria/optimize-locales-plugin": "2.0.2",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/builder-vite": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/node": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint-plugin-better-tailwindcss": "4.4.1",
    "fontaine": "1.0.1",
    "http-server": "14.1.1",
    "oxfmt": "0.45.0",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.20.0",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.6.3",
    "tailwindcss": "catalog:",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
